---
import type { Post } from '@hotmetal/content-core';
import { getFirstTopic } from '../../../lib/post-utils';

interface Props {
  post: Post;
  sanitizedContent: string;
  date: string | null;
  allLabels: string[];
  postUrl: string;
  twitterShareUrl: string;
  linkedinShareUrl: string;
}

const {
  post,
  sanitizedContent,
  date,
  allLabels,
  postUrl,
  twitterShareUrl,
  linkedinShareUrl,
} = Astro.props;

const firstTopic = getFirstTopic(post);

/** Plain-text word count, used for the byline's length and read estimate. */
function countWords(html: string | undefined): number {
  if (!html) return 0;
  return html.replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length;
}

const words = countWords(post.content);
const readMinutes = words > 0 ? Math.max(1, Math.round(words / 220)) : null;

const citations = post.citations ?? [];

/** Publisher if the CMS recorded one, otherwise the source's host. */
function sourceLabel(url: string, publisher: string | undefined): string {
  if (publisher) return publisher;
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
}

const hasComments = Astro.slots.has('comments');

/* -------------------------------------------------------------- contents -- */

const ENTITIES: Record<string, string> = {
  amp: '&',
  lt: '<',
  gt: '>',
  quot: '"',
  apos: "'",
  nbsp: ' ',
};

function decodeEntities(value: string): string {
  return value.replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, (match, entity: string) => {
    if (entity.startsWith('#x') || entity.startsWith('#X')) {
      const code = Number.parseInt(entity.slice(2), 16);
      return Number.isNaN(code) ? match : String.fromCodePoint(code);
    }
    if (entity.startsWith('#')) {
      const code = Number.parseInt(entity.slice(1), 10);
      return Number.isNaN(code) ? match : String.fromCodePoint(code);
    }
    return ENTITIES[entity.toLowerCase()] ?? match;
  });
}

/** Matches the `sec-` anchors this template has always minted. */
function sectionId(text: string, index: number): string {
  const base = text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 48);
  return base ? `sec-${base}` : `sec-${index + 1}`;
}

/** An id we are willing to reuse verbatim as an anchor target. */
const SAFE_ID = /^[A-Za-z][A-Za-z0-9._:-]*$/;

interface Heading {
  id: string;
  text: string;
}

const headings: Heading[] = [];
const usedIds = new Set<string>();

/**
 * The rail is built here, at render time, so the contents work with JavaScript
 * off and the page never reflows from a tocless first paint into a railed one.
 *
 * The content is already sanitized, and every id written back is either an
 * existing conservative id or a freshly slugified one, so no untrusted text
 * reaches the attribute.
 *
 * Two sections can legitimately share a heading, and an author can repeat one
 * by accident. An id authored in the CMS body survives sanitization, so it can
 * collide with a generated one either way round — both go through the same
 * "already used?" loop rather than trusting the authored one.
 */
const contentWithAnchors = sanitizedContent.replace(
  /<h2\b([^>]*)>([\s\S]*?)<\/h2>/gi,
  (_match: string, attrs: string, inner: string) => {
    const text = decodeEntities(inner.replace(/<[^>]*>/g, ' ')).replace(/\s+/g, ' ').trim();

    const existing = /\sid\s*=\s*["']([^"']*)["']/i.exec(attrs);
    const candidate =
      existing && SAFE_ID.test(existing[1]) ? existing[1] : sectionId(text, headings.length);

    let id = candidate;
    let suffix = 2;
    while (usedIds.has(id)) {
      id = `${candidate}-${suffix}`;
      suffix += 1;
    }
    usedIds.add(id);
    headings.push({ id, text: text || `Section ${headings.length + 1}` });

    const rest = existing ? attrs.replace(existing[0], '') : attrs;
    return `<h2 id="${id}"${rest}>${inner}</h2>`;
  },
);

/** No headings means no rail — and no column reserved for one. */
const showContents = headings.length > 0;
---

<div class="sig-progress" id="sig-progress" aria-hidden="true"></div>

<div class:list={['sig-wrap', 'sig-post-wrap', !showContents && 'is-tocless']}>
  <header class="sig-post-head">
    <div class="sig-crumb">
      <span class="sig-kick-n">Dispatch</span>
      <a href="/">&larr; Back to the index</a>
      {firstTopic && <span class="sig-lbl">{firstTopic}</span>}
    </div>

    <h1>{post.title}</h1>

    {post.subtitle && <p class="sig-sub">{post.subtitle}</p>}

    <div class="sig-byline">
      {post.author && <span class="sig-who">{post.author}</span>}
      {date && post.publishedAt && (
        <span><time datetime={post.publishedAt}>{date}</time></span>
      )}
      {readMinutes && <span>{readMinutes} min read</span>}
      {words > 0 && <span>{words.toLocaleString('en-US')} words</span>}
      {citations.length > 0 && <span>{citations.length} sources</span>}
    </div>
  </header>

  {showContents && (
    <nav class="sig-rail" id="sig-rail" aria-label="Sections of this dispatch">
      <h2>In this dispatch</h2>
      <ol id="sig-toc">
        {headings.map((heading, i) => (
          <li>
            <a href={`#${heading.id}`} aria-current={i === 0 ? 'true' : 'false'}>
              {heading.text}
            </a>
          </li>
        ))}
      </ol>
      <div class="sig-meter">
        <div class="sig-track" aria-hidden="true"><div class="sig-fill" id="sig-fill"></div></div>
        <p class="sig-pct">Read <span id="sig-pct-value">0%</span></p>
      </div>
    </nav>
  )}

  <div class="sig-read-col">
    {/* Generated art is a 1024x1024 square; it is only ever cropped to a wide
        strip here, and its absence is simply the absence of a strip. */}
    {post.featuredImage && (
      <div class="sig-post-image">
        <img
          class="sig-strip"
          src={post.featuredImage}
          alt=""
          width="1600"
          height="500"
          loading="eager"
        />
      </div>
    )}

    <article class="sig-body" set:html={contentWithAnchors} />

    {allLabels.length > 0 && (
      <section class="sig-after" aria-labelledby="sig-tags-title">
        <div class="sig-sec-head">
          <h2 id="sig-tags-title">Tags</h2>
          <span class="sig-count">{String(allLabels.length).padStart(2, '0')}</span>
        </div>
        <ul class="sig-tags">
          {allLabels.map((label) => <li>{label}</li>)}
        </ul>
      </section>
    )}

    {citations.length > 0 && (
      <section class="sig-after" aria-labelledby="sig-src-title">
        <div class="sig-sec-head is-tight">
          <h2 id="sig-src-title">Sources</h2>
          <span class="sig-count">{citations.length} cited</span>
        </div>
        <ol class="sig-cites">
          {citations.map((citation, i) => (
            <li>
              <span class="sig-n">{String(i + 1).padStart(2, '0')}</span>
              <a href={citation.url} target="_blank" rel="noopener noreferrer">
                {citation.title}
              </a>
              <span class="sig-dom">{sourceLabel(citation.url, citation.publisher)}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {hasComments && (
      <section class="sig-after" aria-labelledby="sig-cmt-title">
        <div class="sig-sec-head is-tight">
          <h2 id="sig-cmt-title">Responses</h2>
        </div>
        <slot name="comments" />
      </section>
    )}

    <section class="sig-after" aria-labelledby="sig-share-title">
      <div class="sig-sec-head is-tight">
        <h2 id="sig-share-title">Circulate</h2>
      </div>
      <div class="sig-share">
        <span>Share this dispatch</span>
        <div class="sig-share-links">
          <a href={twitterShareUrl} target="_blank" rel="noopener noreferrer">X</a>
          <a href={linkedinShareUrl} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <button type="button" id="sig-copy-link" data-url={postUrl}>Copy link</button>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  function initDispatch() {
    const w = window as unknown as { sigOnScroll?: () => void };
    if (w.sigOnScroll) {
      window.removeEventListener('scroll', w.sigOnScroll);
      window.removeEventListener('resize', w.sigOnScroll);
      w.sigOnScroll = undefined;
    }

    const article = document.querySelector<HTMLElement>('.sig-body');
    if (!article) return;

    const list = document.getElementById('sig-toc');
    const fill = document.getElementById('sig-fill');
    const pct = document.getElementById('sig-pct-value');
    const bar = document.getElementById('sig-progress');

    // The contents list and its heading anchors are rendered on the server; the
    // only job left here is the live state — which entry is current, and how far
    // the reader has come.
    const heads: HTMLElement[] = [];
    const links: HTMLAnchorElement[] = [];

    if (list) {
      list.querySelectorAll('a[href^="#"]').forEach((node) => {
        const link = node as HTMLAnchorElement;
        const heading = document.getElementById(link.getAttribute('href')!.slice(1));
        if (!heading) return;
        heads.push(heading);
        links.push(link);
      });
    }

    /**
     * Scroll position picks the active section: the last heading whose top has
     * crossed the reading line. An IntersectionObserver with a negative
     * rootMargin sticks on the first section and never advances, so it is not
     * used here.
     */
    function syncActive() {
      if (links.length === 0) return;
      const line = window.innerHeight * 0.32;
      let active = 0;
      for (let i = 0; i < heads.length; i++) {
        if (heads[i].getBoundingClientRect().top <= line) active = i;
      }
      for (let i = 0; i < links.length; i++) {
        links[i].setAttribute('aria-current', i === active ? 'true' : 'false');
      }
    }

    let ticking = false;

    function measure() {
      ticking = false;
      const box = article.getBoundingClientRect();
      const travelled = -box.top + window.innerHeight * 0.42;
      const progress = Math.max(0, Math.min(1, travelled / Math.max(1, box.height)));
      const percent = Math.round(progress * 100);
      if (fill) fill.style.height = `${percent}%`;
      if (pct) pct.textContent = `${percent}%`;
      if (bar) bar.style.width = `${percent}%`;
      syncActive();
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(measure);
    }

    w.sigOnScroll = onScroll;
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    measure();
  }

  function initCopyLink() {
    const btn = document.getElementById('sig-copy-link');
    if (!btn) return;

    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => {
          btn.textContent = original;
        }, 2000);
      } catch {
        // Clipboard unavailable — the share links still work.
      }
    });
  }

  initDispatch();
  initCopyLink();
  document.addEventListener('astro:after-swap', () => {
    initDispatch();
    initCopyLink();
  });
</script>
