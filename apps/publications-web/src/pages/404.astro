---
import { env } from 'cloudflare:workers';
import { resolvePublicationForPage } from '../lib/resolve-or-redirect';
import { getPublicationBranding } from '../dl/publication';
import NotFoundPage from '../components/NotFoundPage.astro';

let branding = null;

try {
  const resolved = await resolvePublicationForPage(Astro.locals, Astro.request, env.DAL, env.DEV_PUBLICATION_SLUG, env.DOMAIN_CACHE);
  if (resolved && !(resolved instanceof Response)) {
    branding = getPublicationBranding(resolved.publication);
  }
} catch {
  // If publication resolution fails, render a generic 404
}
---

<NotFoundPage
  templateId={branding?.templateId ?? 'starter'}
  {branding}
/>
