{
  "name": "hotmetal",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "cms:migrate:local": "pnpm --filter @hotmetal/cms-admin db:migrate:local",
    "cms:migrate:remote": "pnpm --filter @hotmetal/cms-admin db:migrate:remote",
    "cms:seed": "pnpm --filter @hotmetal/cms-admin seed",
    "cms:reset:local": "rm -rf apps/cms-admin/.wrangler/state && pnpm cms:migrate:local && pnpm cms:seed",
    "dal:migrate:local": "pnpm --filter @hotmetal/data-layer db:migrate:local",
    "dal:migrate:remote": "pnpm --filter @hotmetal/data-layer db:migrate:remote",
    "dal:reset:local": "rm -rf .wrangler/shared-state && pnpm dal:migrate:local && bash scripts/seed-dev-user.sh",
    "dal:seed:dev": "bash scripts/seed-dev-user.sh",
    "db:migrate:local": "pnpm cms:migrate:local && pnpm dal:migrate:local",
    "db:migrate:remote": "pnpm cms:migrate:remote && pnpm dal:migrate:remote",
    "db:reset:local": "pnpm cms:reset:local && pnpm dal:reset:local",
    "db:reset:remote": "pnpm cms:migrate:remote && pnpm dal:migrate:remote",
    "deploy:cms": "pnpm --filter @hotmetal/cms-admin run deploy",
    "deploy:dal": "pnpm --filter @hotmetal/data-layer run deploy",
    "deploy:scout": "pnpm --filter @hotmetal/content-scout run deploy",
    "deploy:publisher": "pnpm --filter @hotmetal/publisher run deploy",
    "deploy:notifications": "pnpm --filter @hotmetal/notifications run deploy",
    "deploy:web": "pnpm --filter @hotmetal/web run deploy",
    "deploy:pub-web": "pnpm --filter @hotmetal/publications-web run deploy",
    "deploy:analyzer": "pnpm --filter @hotmetal/content-analyzer run deploy",
    "deploy:docs": "pnpm --filter @hotmetal/docs run deploy",
    "deploy:emdash": "pnpm --filter @hotmetal/emdash-blog run deploy",
    "deploy:provisioner": "pnpm --filter @hotmetal/provisioner run deploy",
    "deploy:dispatch": "pnpm --filter @hotmetal/emdash-dispatch run deploy",
    "deploy:all": "pnpm deploy:cms && pnpm deploy:dal && pnpm deploy:scout && pnpm deploy:publisher && pnpm deploy:notifications && pnpm deploy:web",
    "dev:cms": "pnpm --filter @hotmetal/cms-admin dev",
    "dev:dal": "pnpm --filter @hotmetal/data-layer dev",
    "dev:blog": "pnpm --filter @hotmetal/blog-frontend dev",
    "dev:publisher": "pnpm --filter @hotmetal/publisher dev",
    "dev:web": "pnpm --filter @hotmetal/web dev",
    "dev:scout": "pnpm --filter @hotmetal/content-scout dev",
    "dev:notifications": "pnpm --filter @hotmetal/notifications dev",
    "dev:pub-web": "pnpm --filter @hotmetal/publications-web dev",
    "dev:docs": "pnpm --filter @hotmetal/docs dev",
    "dev:analyzer": "pnpm --filter @hotmetal/content-analyzer dev",
    "dev:emdash": "pnpm --filter @hotmetal/emdash-blog dev",
    "preview:emdash": "pnpm --filter @hotmetal/emdash-blog preview",
    "dev:stack": "STACK=true pnpm --filter @hotmetal/web dev",
    "dev:stack-pub": "STACK=true pnpm --filter @hotmetal/publications-web dev"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@mongodb-js/zstd",
      "better-sqlite3",
      "esbuild",
      "node-liblzma",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.6.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  }
}
