{
  "name": "@hotmetal/data-layer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to ../../.wrangler/shared-state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hotmetal/content-core": "workspace:*",
    "@hotmetal/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.155.0",
    "@cloudflare/vitest-plugin": "^1.4.10"
  }
}
