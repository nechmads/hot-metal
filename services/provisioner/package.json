{
	"name": "@hotmetal/provisioner",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --persist-to ../../.wrangler/shared-state",
		"start": "wrangler dev",
		"test": "vitest run",
		"cf-typegen": "wrangler types",
		"build": "wrangler deploy --dry-run --outdir=dist",
		"typecheck": "tsc --noEmit",
		"release-bundle": "tsx scripts/release-bundle.ts"
	},
	"dependencies": {
		"@emdash-cms/auth": "0.22.0",
		"@hotmetal/data-layer": "workspace:*",
		"@hotmetal/shared": "workspace:*",
		"hono": "^4.12.25",
		"ulidx": "^2.4.1"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.16.15",
		"@types/node": "^25.2.2",
		"tsx": "^4.19.0",
		"typescript": "^5.5.2",
		"vitest": "~4.1.8",
		"wrangler": "^4.100.0"
	}
}
