{
  "name": "@hotmetal/provisioner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --persist-to ../../.wrangler/shared-state",
    "start": "wrangler dev",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "release-bundle": "tsx scripts/release-bundle.ts"
  },
  "dependencies": {
    "@emdash-cms/auth": "1.3.1",
    "@hotmetal/data-layer": "workspace:*",
    "@hotmetal/shared": "workspace:*",
    "hono": "^4.13.14",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "emdash": "1.3.1",
    "emdash-legacy-0-22": "npm:emdash@0.22.0",
    "kysely": "^0.29.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "~5.0.5",
    "wrangler": "^4.155.0",
    "@cloudflare/vitest-plugin": "^1.4.10"
  }
}
